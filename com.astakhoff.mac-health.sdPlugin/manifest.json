{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.astakhoff.mac-health",
  "Name": "Mac Health",
  "Version": "1.4.0.0",
  "Author": "Astakhoff",
  "Description": "Separate memory, CPU, disk-space, and Time Machine backup-age indicators for macOS.",
  "Category": "Mac Health",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.mjs",
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Software": {
    "MinimumVersion": "6.9"
  },
  "SDKVersion": 3,
  "Nodejs": {
    "Version": "20"
  },
  "URL": "https://github.com/Astakhoff/stream_deck_mac_health",
  "Actions": [
    {
      "UUID": "com.astakhoff.mac-health.memory",
      "Name": "Memory",
      "Icon": "imgs/memory-action",
      "Controllers": [
        "Keypad"
      ],
      "Tooltip": "RAM usage, memory pressure color, and a rolling 5-minute swap trend. Press to open Activity Monitor.",
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/memory-key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.astakhoff.mac-health.cpu",
      "Name": "CPU",
      "Icon": "imgs/cpu-action",
      "Controllers": [
        "Keypad"
      ],
      "Tooltip": "CPU load, a rolling 5-minute graph, and color informed by system thermal pressure. Press to open Activity Monitor.",
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/cpu-key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.astakhoff.mac-health.disk",
      "Name": "Disk",
      "Icon": "imgs/disk-action",
      "Controllers": [
        "Keypad"
      ],
      "Tooltip": "Toggle used or remaining disk percentage and GiB. The bar always shows used capacity.",
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/disk-key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.astakhoff.mac-health.backup",
      "Name": "Backup",
      "Icon": "imgs/backup-action",
      "Controllers": [
        "Keypad"
      ],
      "Tooltip": "Age of the latest known completed Time Machine backup, including disconnected destinations. Press to open System Settings.",
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/backup-key",
          "ShowTitle": false
        }
      ]
    }
  ]
}
